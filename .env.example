# --- LLM ---
# ollama (défaut, local) | openai (toute API compatible OpenAI)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_HOST=http://localhost:11434
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- RAG ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
CHROMA_PATH=./chroma_db

# Delai d'attente par appel, en secondes. Genereux par defaut : en CPU, un
# modele 7B met plusieurs minutes sur un prompt de 2 000 tokens.
LLM_TIMEOUT=900

# Reproductibilité : ne jamais changer.
TEMPERATURE=0
